# Simulated native text-service callbacks, not an installed OS IME.
app = open_app()
click(app, "name")
compose(app, "name", "に")
assert_eq(inspect(app, "name")["value"], "に")
assert_eq(inspect(app, "name")["marked"], [0, 1])
assert_true(state(app)["composing"])
update(app, "rerender")
assert_eq(inspect(app, "name")["marked"], [0, 1], "Go echo must preserve marked text")
compose(app, "name", "日本語")
assert_eq(inspect(app, "name")["marked"], [0, 3])
compose(app, "name", "日本語", commit = True)
assert_eq(inspect(app, "name")["marked"], None)
assert_eq(state(app)["name"], "日本語")
assert_eq(state(app)["composing"], False)
assert_eq(inspect(app, "name")["selection"], [3, 3])

# Reset while composing must clear the native mark and advance the Go epoch.
compose(app, "name", "仮")
update(app, "replace", "Authoritative")
assert_eq(inspect(app, "name")["marked"], None)
assert_eq(inspect(app, "name")["value"], "Authoritative")
type_text(app, "!")
assert_eq(state(app)["name"], "Authoritative!")
close_app(app)
