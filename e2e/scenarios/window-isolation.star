first = open_app()
second = open_app()
click(first, "name")
type_text(first, "First 日本語")
click(second, "name")
type_text(second, "Second 🙂")
assert_eq(state(first)["name"], "First 日本語")
assert_eq(state(second)["name"], "Second 🙂")
click(first, "increment")
assert_eq(state(first)["count"], 1)
assert_eq(state(second)["count"], 0)
close_app(first)
click(second, "name")
key(second, "end")
type_text(second, " remains")
assert_eq(state(second)["name"], "Second 🙂 remains")
close_app(second)
reopened = open_app()
assert_eq(state(reopened)["count"], 0)
assert_eq(inspect(reopened, "name")["value"], "")
click(reopened, "increment")
assert_eq(state(reopened)["count"], 1)
close_app(reopened)
