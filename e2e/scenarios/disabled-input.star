app = open_app()
click(app, "name")
type_text(app, "Allowed")
update(app, "disable")
type_text(app, " ignored")
assert_eq(state(app)["name"], "Allowed")
assert_eq(inspect(app, "name")["value"], "Allowed")
key(app, "tab tab")
assert_eq(inspect(app, "other")["focused_element_id"], 14)
click(app, "disabled")
assert_eq(inspect(app, "other")["focused_element_id"], 14, "disabled input cannot steal focus")
type_text(app, "Other")
assert_eq(state(app)["other"], "Other")
assert_eq(inspect(app, "disabled")["value"], "Locked")
update(app, "disable", "false")
click(app, "name")
key(app, "end")
type_text(app, " again")
assert_eq(state(app)["name"], "Allowed again")
close_app(app)
