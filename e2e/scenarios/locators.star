page = open_page()
page.set_default_timeout(2000)
name = page.get_by_role("textbox", name = "Name", exact = True)
expect(name).to_be_visible()
expect(name).to_be_enabled()
name.fill("Page API 日本語🙂")
expect(name).to_have_value("Page API 日本語🙂")
expect(name).to_be_focused()
name.press("ControlOrMeta+A")
page.keyboard.insert_text("Replaced")
expect(page.get_by_test_id("mirror")).to_have_text("Name: Replaced")
expect(page.get_by_role("textbox")).to_have_count(3)
expect(page.get_by_role("textbox", name = "Locked field")).to_be_disabled()
expect(page.get_by_role("textbox").last).to_have_value("")

notifications = page.get_by_role("checkbox", name = "Enable notifications")
expect(notifications).not_to_be_checked()
notifications.check()
notifications.check()  # Idempotent: do not toggle a checked checkbox again.
expect(notifications).to_be_checked()
assert_true(page.state()["checked"])
notifications.uncheck()
expect(notifications).not_to_be_checked()

increment = page.get_by_role("button", name = "Increment native model", exact = True)
counter = page.locator("count")
increment.click()
expect(counter).to_have_text("Count: 1")
page.update("rerender")
increment.click()
expect(counter).to_have_text("Count: 2")  # Locators observe current snapshots.
expect(page.get_by_role("button")).to_have_count(2)

# A live text query includes virtual rows; click reveals the row before dispatch.
row = page.get_by_text("Row 999", exact = True)
expect(row).to_be_hidden()
row.click()
expect(row).to_be_visible()
expect(page.get_by_test_id("selected")).to_have_text("Selected: 999")
page.close()
