app = open_app()
assert_eq(inspect(app, "row-999")["rendered"], False)
update(app, "scroll_last")
assert_true(inspect(app, "row-999")["rendered"], "scrolling must actually prepaint the last row")
click(app, "row-999")
assert_eq(state(app)["selected"], 999)
assert_eq(inspect(app, "selected")["text"], "Selected: 999")
update(app, "rerender")
assert_true(inspect(app, "row-999")["rendered"], "scroll state survives a snapshot")
close_app(app)
